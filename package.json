  "description": "한상호의 웹 이력서 (Next.js static export + GitHub Pages)",
  "private": true,
  "scripts": {
    "dev": "next",
    "build": "next build",
    "prebuild": "npm run lint",
    "start": "next start",
    "export": "cross-env NODE_ENV=production next export --outdir docs/",
    "preexport": "npm run clean && npm run build",
    "postexport": "node shellwork.js",
    "clean": "rimraf docs .next",
    "lint": "eslint 'component/**/*' 'pages/**/*' 'payload/**/*' 'lib/**/*' '*.ts' --fix"
  },
  "homepage": "https://sanghohan.github.io/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanghohan/sanghohan.github.io.git"
  },
  "author": {
    "name": "Sangho Han",
